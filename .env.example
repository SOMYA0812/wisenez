# Copy to .env and set locally. Never commit real credentials.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
# Optional alternative: direct Gemini instead of OpenRouter.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional: use a separate database for another local demo.
DEALDESK_DB=data/dealdesk.sqlite3
# Judge demo is public. Set to 1 to require a code for a private workspace.
WISNEZ_REQUIRE_ACCESS_CODE=0
# For private mode, use a random code of at least 16 characters.
WISNEZ_ACCESS_CODE=
# Production only: connect a private Vercel Blob store for persistent snapshots.
BLOB_READ_WRITE_TOKEN=
